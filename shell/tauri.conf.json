{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReBuilt",
  "version": "0.3.0",
  "identifier": "com.nekolab.rebuilt",
  "build": {
    "frontendDist": "./splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ReBuilt",
        "url": "index.html",
        "width": 1280,
        "height": 832,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/rebuilt-server"]
  }
}
